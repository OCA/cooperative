From 422c3df8b6e467e0fb3fb614dea95d8850aab868 Mon Sep 17 00:00:00 2001
From: Carmen Bianca Bakker <carmen@coopiteasy.be>
Date: Mon, 29 Nov 2021 11:25:52 +0100
Subject: [IMP] easy_my_coop: Ascertain that companies cannot request shares
 for individuals

And vice versa.

Signed-off-by: Carmen Bianca Bakker <carmen@coopiteasy.be>
---
 easy_my_coop/models/subscription_request.py | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/easy_my_coop/models/subscription_request.py b/easy_my_coop/models/subscription_request.py
index d3093d81..d4fc013e 100644
--- a/easy_my_coop/models/subscription_request.py
+++ b/easy_my_coop/models/subscription_request.py
@@ -60,6 +60,20 @@ class SubscriptionRequest(models.Model):
             vals["already_cooperator"] = True
         return vals

+    @api.constrains("share_product_id", "is_company")
+    def _check_share_available_to_user(self):
+        for request in self:
+            if request.is_company and not request.share_product_id.by_company:
+                raise ValidationError(
+                    _("%s is not available to companies")
+                    % request.share_product_id.name
+                )
+            elif not request.is_company and not request.share_product_id.by_individual:
+                raise ValidationError(
+                    _("%s is not available to individuals")
+                    % request.share_product_id.name
+                )
+
     @api.model
     def create(self, vals):
         partner_obj = self.env["res.partner"]
