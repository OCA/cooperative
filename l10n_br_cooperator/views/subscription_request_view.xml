<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="subscription_request_view_form">
        <field name="name">subscription.request.form.l10n.br</field>
        <field name="model">subscription.request</field>
        <field name="inherit_id" ref="cooperator.subscription_request_view_form" />
        <field name="arch" type="xml">
            <field name="lastname" position="after">
                <field name="vat" />
            </field>
            <field name="company_name" position="after">
                <field name="legal_name" invisible="not is_company" />
            </field>
            <!-- No Brasil este campo e o CNPJ: preenchido a partir do
                 CPF/CNPJ, mantido visivel e somente leitura -->
            <field name="company_register_number" position="attributes">
                <attribute name="string">CNPJ (registro da empresa)</attribute>
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>
</odoo>
