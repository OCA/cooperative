<odoo>
    <record id="subscription_request_tree" model="ir.ui.view">
        <field name="name">subscription.request.list</field>
        <field name="model">subscription.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="firstname" />
                <field name="lastname" />
                <field name="company_name" />
                <field name="date" string="Request Date" />
                <field name="type" />
                <field name="share_short_name" string="Share Type" />
                <field
                    name="ordered_parts"
                    string="Quantity"
                    sum="Total ordered parts"
                />
                <field name="subscription_amount" sum="Total amount" />
                <field name="email" />
                <field name="iban" />
                <field name="partner_id" />
                <field name="source" />
                <field name="state" />
                <field name="is_valid_iban" invisible="True" />
                <field name="company_id" groups="base.group_multi_company" />
                <button
                    type="object"
                    string="Validate"
                    aria-label="Validate"
                    name="validate_subscription_request"
                    invisible="state not in ('draft', 'waiting') or not is_valid_iban"
                />
                <button
                    type="object"
                    string="Block"
                    aria-label="Block"
                    name="block_subscription_request"
                    invisible="state != 'draft'"
                    groups="cooperator.cooperator_group_user"
                />
                <button
                    type="object"
                    string="Unblock"
                    aria-label="Unblock"
                    name="unblock_subscription_request"
                    invisible="state != 'blocked'"
                    groups="cooperator.cooperator_group_user"
                />
            </list>
        </field>
    </record>

    <record id="subscription_request_view_form" model="ir.ui.view">
        <field name="name">subscription.request.view.form</field>
        <field name="model">subscription.request</field>
        <field name="arch" type="xml">
            <form string="Subscription Requests">
                <header>
                    <button
                        string="Validate"
                        type="object"
                        name="validate_subscription_request"
                        invisible="state not in ('draft', 'waiting') or not is_valid_iban"
                    />
                    <button
                        string="Waiting list"
                        type="object"
                        name="put_on_waiting_list"
                        invisible="state != 'draft'"
                    />
                    <button
                        string="Cancel"
                        type="object"
                        name="cancel_subscription_request"
                        invisible="state not in ('draft', 'waiting', 'done', 'blocked')"
                        groups="cooperator.cooperator_group_user"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,cancelled,done,failed"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        text="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="True" />
                    <group>
                        <group>
                            <field name="is_valid_iban" invisible="True" />
                            <field
                                name="already_cooperator"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="is_company"
                                groups="cooperator.cooperator_group_manager"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="is_company"
                                groups="!cooperator.cooperator_group_manager"
                                invisible="True"
                            />
                            <field name="is_operation" invisible="True" />
                            <field
                                name="company_name"
                                invisible="not is_company"
                                required="is_company"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="company_email"
                                invisible="not is_company"
                                required="is_company"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="company_type"
                                invisible="not is_company"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="company_register_number"
                                invisible="not is_company"
                                required="is_company"
                                readonly="state != 'draft'"
                            />
                            <field name="firstname" readonly="state != 'draft'" />
                            <field name="lastname" readonly="state != 'draft'" />
                            <field name="birthdate" readonly="state != 'draft'" />
                            <field name="gender" readonly="state != 'draft'" />
                            <field name="email" readonly="state != 'draft'" />
                            <field name="phone" readonly="state != 'draft'" />
                            <field
                                name="contact_person_function"
                                invisible="not is_company"
                                readonly="state != 'draft'"
                            />
                            <!-- todo highlight iban if not valid -->
                            <field name="iban" readonly="state != 'draft'" />
                            <field name="address" readonly="state != 'draft'" />
                            <field name="zip_code" readonly="state != 'draft'" />
                            <field name="city" readonly="state != 'draft'" />
                            <field
                                name="country_id"
                                options="{'no_create':True}"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group>
                            <field
                                name="capital_release_request_date"
                                groups="cooperator.cooperator_group_manager"
                                readonly="state != 'draft'"
                            />
                            <field name="date" readonly="state != 'draft'" />
                            <field name="source" readonly="state != 'draft'" />
                            <field name="ordered_parts" readonly="state != 'draft'" />
                            <field
                                name="share_product_id"
                                options="{'no_create':True}"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="share_short_name"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="share_unit_price"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="subscription_amount"
                                readonly="state != 'draft'"
                            />
                            <field
                                name="partner_id"
                                options="{'no_create':True}"
                                readonly="state != 'draft'"
                            />
                            <field name="type" readonly="state != 'draft'" />
                            <field name="lang" readonly="state != 'draft'" />
                            <field name="skip_iban_control" />
                            <field name="internal_rules_approved" />
                            <field name="data_policy_approved" />
                            <field name="financial_risk_approved" />
                            <field name="generic_rules_approved" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                                readonly="id"
                            />
                            <field
                                name="company_id"
                                groups="!base.group_multi_company"
                                invisible="True"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page
                            name="capital_release_request"
                            string="Capital release request"
                        >
                            <field
                                name="capital_release_request"
                                readonly="state != 'draft'"
                            >
                                <list options="{'no_create':True}">
                                    <field name="state" invisible="True" />
                                    <field string="Cooperator" name="partner_id" />
                                    <field name="invoice_date" />
                                    <field name="name" />
                                    <field
                                        string="Reference"
                                        name="payment_reference"
                                    />
                                    <field name="invoice_date_due" />
                                    <field name="amount_total_signed" />
                                    <field name="amount_residual_signed" />
                                    <field name="payment_state" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_subscription_request_filter" model="ir.ui.view">
        <field name="name">Cooperator Subscription Search</field>
        <field name="model">subscription.request</field>
        <field name="arch" type="xml">
            <search string="Search Subscription Request">
                <field name="name" />
                <field name="partner_id" />
                <separator />
                <filter
                    string="Draft"
                    name="state_draft"
                    domain="[('state','=','draft')]"
                />
                <filter
                    string="Paid"
                    name="state_paid"
                    domain="[('state','=','paid')]"
                />
                <filter
                    string="Done"
                    name="state_done"
                    domain="[('state','=','done')]"
                />
                <separator />
                <filter
                    string="Invalid IBAN"
                    name="is_valid_iban"
                    domain="[('is_valid_iban', '=', False)]"
                />
                <group expand="0" name="group_by" string="Group By">
                    <filter
                        name="request_type"
                        string="Request type"
                        context="{'group_by' : 'type'}"
                    />
                    <filter
                        name="date"
                        string="Request Date"
                        context="{'group_by': 'date'}"
                    />
                </group>
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active','=',False)]"
                />
            </search>
        </field>
    </record>

    <record id="subscription_request_action" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">subscription.request</field>
        <field name="domain">[('is_operation','=',False)]</field>
        <field name="context">{'default_source':'manual'}</field>
        <field name="view_id" ref="subscription_request_tree" />
        <field name="search_view_id" ref="view_subscription_request_filter" />
    </record>

    <record id="share_line_form" model="ir.ui.view">
        <field name="name">share.line.form</field>
        <field name="model">share.line</field>
        <field name="arch" type="xml">
            <form string="Share line">
                <header>
                    <button
                        string="Update info"
                        name="%(action_view_update_share_line_info)d"
                        type="action"
                        context="{'default_active_id': id}"
                        groups="cooperator.cooperator_group_manager"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="share_product_id" />
                            <field name="share_number" />
                        </group>
                        <group>
                            <field name="share_short_name" />
                            <field name="share_unit_price" />
                            <field name="effective_date" />
                            <field name="total_amount_line" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="share_line_tree" model="ir.ui.view">
        <field name="name">share.line.list</field>
        <field name="model">share.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id" />
                <field name="share_product_id" />
                <field name="share_number" />
                <field name="share_short_name" />
                <field name="share_unit_price" />
                <field name="effective_date" />
                <field name="total_amount_line" />
            </list>
        </field>
    </record>

    <record id="view_share_line_filter" model="ir.ui.view">
        <field name="name">Share Line Search</field>
        <field name="model">share.line</field>
        <field name="arch" type="xml">
            <search string="Search Share Line">
                <field name="partner_id" />
                <field name="effective_date" />
                <separator />
                <group name="group_by" string="Group By">
                    <filter
                        name="cooperator"
                        string="Cooperator"
                        context="{'group_by' : 'partner_id'}"
                    />
                    <filter
                        name="effective_date"
                        string="Effective date"
                        context="{'group_by': 'effective_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="share_line_action" model="ir.actions.act_window">
        <field name="name">Share Lines</field>
        <field name="res_model">share.line</field>
    </record>
</odoo>
