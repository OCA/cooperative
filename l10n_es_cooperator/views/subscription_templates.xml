<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="become_company_cooperator_es"
        inherit_id="cooperator_website.becomecompanycooperator"
        name="Become company cooperator"
        priority="150"
    >
        <xpath
            expr="//div[@name='company_register_number_container']"
            position="replace"
        />
        <!-- Remove Company type field -->
        <xpath expr="//div[@name='company_type_container']" position="replace" />
    </template>

    <template id="iban_template_es" inherit_id="cooperator_website.iban_template">
        <xpath expr="//div[@name='iban_template_container']" position="inside">

            <div class="mb-3 field-bank_account" name="iban_container">
                <label for="iban" class="form-label">Bank Account Number</label>
                <input
                    t-attf-class="form-control form-control-sm{{ error and 'iban' in error and ' is-invalid' or '' }}"
                    type="text"
                    name="iban"
                    id="iban"
                    required="True"
                    t-att-readonly="logged"
                    t-att-value="iban"
                    placeholder="ES9000246912501234567891"
                />
            </div>
            <div class="mb-3 field-vat" name="vat_container">
                <label for="vat" class="form-label">VAT</label>
                <input
                    t-attf-class="form-control form-control-sm{{ error and 'vat' in error and ' is-invalid' or '' }}"
                    type="text"
                    name="vat"
                    id="vat"
                    required="True"
                    t-att-value="vat"
                    placeholder="Y5643925S"
                />
            </div>
        </xpath>
    </template>

    <template
        id="become_cooperator_es_share_div"
        inherit_id="cooperator_website.shares_template"
        name="Removing Share div"
    >
        <xpath expr="//div[@name='share_div']" position="attributes">
            <attribute name="hidden">1</attribute>
        </xpath>
    </template>
</odoo>
